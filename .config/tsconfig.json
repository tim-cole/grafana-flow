 {
  "compilerOptions": {
    "alwaysStrict": true,
    "declaration": false,
    "rootDir": "../src",
    "baseUrl": "../src",
    "typeRoots": ["../node_modules/@types"],
    "resolveJsonModule": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      // Manually added: @grafana/tsconfig's base "moduleResolution": "bundler" is
      // incompatible with "module": "commonjs" under TS 5.9 (TS5095). Must be
      // re-applied if this file is regenerated by a future `create-plugin update`.
      "moduleResolution": "node",
      "target": "es5",
      "esModuleInterop": true
    },
    "transpileOnly": true
  },
  "include": ["../src", "./types"],
  "extends": "@grafana/tsconfig"
}
